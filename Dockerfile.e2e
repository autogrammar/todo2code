# syntax=docker/dockerfile:1.7

FROM golang:1.23-bookworm AS go-toolchain
FROM rust:1.85-slim-bookworm AS rust-toolchain

FROM node:22-bookworm-slim AS e2e-base

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates curl git python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
ENV NODE_ENV=test \
    T2C_ROOT=/workspace \
    T2C_ENV_FILE=/workspace/.env.e2e-missing \
    OPENROUTER_API_KEY= \
    T2C_NL_MODE=deterministic \
    T2C_MARKDOWN_MODE=deterministic \
    T2C_COMMUNICATION_MODE=deterministic

COPY package.json package-lock.json tsconfig.json .intentignore ./
RUN npm ci --include=dev
COPY . .
RUN npm run build

FROM e2e-base AS e2e-core
CMD ["bash", "scripts/e2e.sh", "core"]

FROM e2e-base AS e2e-full

USER root
COPY --from=go-toolchain /usr/local/go /usr/local/go
COPY --from=rust-toolchain /usr/local/cargo /usr/local/cargo
COPY --from=rust-toolchain /usr/local/rustup /usr/local/rustup
ENV PATH=/usr/local/go/bin:/usr/local/cargo/bin:$PATH \
    CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    T2C_REQUIRE_JAVA_TEST=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential default-jdk-headless php-cli \
    && rm -rf /var/lib/apt/lists/* \
    && cargo fetch --locked --manifest-path sdk/rust/Cargo.toml

CMD ["bash", "scripts/e2e.sh", "full"]
