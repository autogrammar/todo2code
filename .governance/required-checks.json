{
  "schema": "new-project.required-checks/v1",
  "version": 2,
  "repository": "autogrammar/todo2code",
  "workflowFile": ".github/workflows/ci.yml",
  "requiredCheckNames": [
    "governance",
    "verify",
    "Java adapter (JDK 17 required)",
    "Live OpenRouter contract (opt-in)"
  ],
  "circularGovernanceChecksIgnoredByValidator": [
    "governance / enforce",
    "governance / governance / enforce"
  ],
  "externalConsumers": [
    {
      "name": "protected-validator-profile",
      "repository": "autogrammar/todo2code",
      "requiredChecks": [
        "verify",
        "Java adapter (JDK 17 required)",
        "koru / code-review"
      ],
      "note": "External protected Validator profile is unchanged. Koru publishes its check independently of repository workflow jobs."
    }
  ]
}
