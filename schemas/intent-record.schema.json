{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todo2code.local/schemas/intent-record.schema.json",
  "title": "todo2code Intent Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "statement", "lifecycle", "source", "epistemic", "observedAt", "metadata"],
  "properties": {
    "schemaVersion": { "const": "t2c.intent/v1" },
    "id": { "type": "string", "pattern": "^INT-[A-Z]+-[a-f0-9]{20}$" },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "actor", "action", "subject", "object", "target", "modality", "polarity", "text"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "actor": { "type": ["string", "null"] },
        "action": {
          "enum": ["add", "fix", "remove", "refactor", "test", "document", "configure", "analyze", "validate", "call", "depend_on", "declare", "release", "change", "preserve", "block", "approve", "unknown"]
        },
        "subject": { "type": ["string", "null"] },
        "object": { "type": "string", "minLength": 1 },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["paths", "symbols", "tickets", "versions"],
          "properties": {
            "paths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "symbols": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "tickets": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "versions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          }
        },
        "modality": { "enum": ["required", "recommended", "optional", "observed", "claimed", "unknown"] },
        "polarity": { "enum": ["positive", "negative"] },
        "text": { "type": "string" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["proposed", "planned", "in_progress", "implemented", "verified", "released", "completed", "blocked", "unknown"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "lines", "revision", "symbol", "commitIndex", "extractor", "contentHash", "rawExcerpt"],
      "properties": {
        "kind": { "enum": ["nl", "git", "ast", "todo", "changelog", "document", "agent_log", "test", "system"] },
        "path": { "type": ["string", "null"] },
        "lines": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "end"],
              "properties": {
                "start": { "type": "integer", "minimum": 1 },
                "end": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        },
        "revision": { "type": ["string", "null"] },
        "symbol": { "type": ["string", "null"] },
        "commitIndex": { "type": ["integer", "null"], "minimum": 1 },
        "extractor": { "type": "string" },
        "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "rawExcerpt": { "type": ["string", "null"] }
      }
    },
    "epistemic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "confidence", "basis"],
      "properties": {
        "class": { "enum": ["declaration", "plan", "claim", "fact", "inference", "llm_inference"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "basis": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "observedAt": { "type": ["string", "null"], "format": "date-time" },
    "metadata": {
      "type": "object",
      "required": ["generation"],
      "properties": {
        "generation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generator", "generatorVersion", "runtimeVersion", "requested", "used", "degraded", "fallbackReason", "provider", "model", "responseId"],
          "properties": {
            "generator": { "type": "string", "minLength": 1 },
            "generatorVersion": { "type": "string", "minLength": 1 },
            "runtimeVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
            "requested": { "enum": ["deterministic", "llm"] },
            "used": { "enum": ["deterministic", "llm"] },
            "degraded": { "type": "boolean" },
            "fallbackReason": { "type": ["string", "null"] },
            "provider": { "type": ["string", "null"] },
            "model": { "type": ["string", "null"] },
            "responseId": { "type": ["string", "null"] }
          },
          "allOf": [
            {
              "if": { "properties": { "used": { "const": "llm" } }, "required": ["used"] },
              "then": {
                "properties": {
                  "provider": { "type": "string", "minLength": 1 },
                  "model": { "type": "string", "minLength": 1 }
                }
              }
            },
            {
              "if": { "properties": { "used": { "const": "deterministic" } }, "required": ["used"] },
              "then": {
                "properties": {
                  "provider": { "type": "null" },
                  "model": { "type": "null" },
                  "responseId": { "type": "null" }
                }
              }
            }
          ]
        }
      }
    }
  }
}
