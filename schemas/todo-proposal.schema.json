{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todo2code.local/schemas/todo-proposal.schema.json",
  "title": "todo2code Grounded TODO Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "description", "priority", "status", "target", "acceptanceCriteria", "dependencies", "conclusionIds", "diagnosticIds", "recordIds", "confidence", "generation"],
  "properties": {
    "schemaVersion": { "const": "t2c.todo-proposal/v1" },
    "id": { "type": "string", "pattern": "^TPROP-[a-f0-9]{20}$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "priority": { "enum": ["P0", "P1", "P2", "P3"] },
    "status": { "const": "proposed" },
    "target": { "$ref": "#/$defs/target" },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^TPROP-[a-f0-9]{20}$" }
    },
    "conclusionIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^CONC-[a-f0-9]{20}$" }
    },
    "diagnosticIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^DIAG-[a-f0-9]{20}$" }
    },
    "recordIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^INT-[A-Z]+-[a-f0-9]{20}$" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "generation": { "$ref": "conclusion.schema.json#/$defs/generation" }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "symbols", "tickets", "versions"],
      "properties": {
        "paths": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "symbols": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "tickets": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "versions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  }
}
