{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todo2code.dev/schemas/participant-synthesis.schema.json",
  "title": "Grounded participant communication synthesis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "participant", "role", "tickets", "summary", "commitments", "risks", "recordIds", "confidence", "generation"],
  "properties": {
    "schemaVersion": { "const": "t2c.participant-synthesis/v1" },
    "id": { "type": "string", "pattern": "^COMM-SYN-[a-f0-9]{20}$" },
    "participant": { "type": "string", "minLength": 1 },
    "role": { "enum": ["human", "agent", "unknown"] },
    "tickets": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "summary": { "type": "string", "minLength": 1 },
    "commitments": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "risks": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "recordIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^INT-[A-Z]+-[a-f0-9]{20}$" }, "uniqueItems": true },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "generatorVersion", "runtimeVersion", "generatedAt", "requestedMode", "effectiveMode", "degraded", "model", "provider", "responseId", "configurationFingerprint", "reason"],
      "properties": {
        "generator": { "type": "string", "minLength": 1 },
        "generatorVersion": { "type": "string", "minLength": 1 },
        "runtimeVersion": { "type": "string" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "requestedMode": { "enum": ["deterministic", "prefer-llm", "require-llm"] },
        "effectiveMode": { "enum": ["deterministic", "llm"] },
        "degraded": { "type": "boolean" },
        "model": { "type": ["string", "null"] },
        "provider": { "type": ["string", "null"] },
        "responseId": { "type": ["string", "null"] },
        "configurationFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reason": { "type": ["string", "null"] }
      }
    }
  }
}
