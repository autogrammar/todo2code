{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todo2code.dev/schemas/gold-dataset.schema.json",
  "title": "todo2code versioned gold dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "description",
    "extraction",
    "linking",
    "dsl2todo"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "t2c.gold-dataset/v1",
        "t2c.gold-dataset/v2"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "extraction": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/extractionCase"
      }
    },
    "linking": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/linkingCase"
      }
    },
    "dsl2todo": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/dsl2todoCase"
      }
    },
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diagnosticsCase"
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "tickets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "versions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceKind",
        "action",
        "text",
        "lifecycle",
        "modality",
        "polarity",
        "paths",
        "symbols",
        "tickets",
        "versions",
        "lines"
      ],
      "properties": {
        "sourceKind": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "lifecycle": {
          "type": "string"
        },
        "modality": {
          "type": "string"
        },
        "polarity": {
          "enum": [
            "positive",
            "negative"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "tickets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "versions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "lines": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 1
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        }
      }
    },
    "extractionCase": {
      "type": "object",
      "required": [
        "id",
        "channel",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "enum": [
            "nl",
            "documentation",
            "documentation-deterministic",
            "markdown"
          ]
        },
        "sourcePath": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "todoPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "changelogPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "documentResponse": {
          "type": "object"
        },
        "expected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projection"
          }
        }
      }
    },
    "fixtureRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "sourceKind",
        "action",
        "text",
        "lifecycle"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "sourceKind": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "polarity": {
          "enum": [
            "positive",
            "negative"
          ]
        },
        "statementKind": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "type": "object"
        },
        "modality": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "linkingCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "records",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "cohort": {
          "enum": [
            "cross-language"
          ]
        },
        "records": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/fixtureRecord"
          }
        },
        "expected": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "type"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "relationClass": {
                "enum": [
                  "exact-target",
                  "capability-topic"
                ]
              }
            }
          }
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            }
          }
        },
        "knownGap": {
          "type": "boolean"
        },
        "reranker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "modelRevision", "decisions"],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "modelRevision": {
              "type": "string",
              "minLength": 1
            },
            "decisions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "module",
                  "score",
                  "verdict",
                  "confidence",
                  "reasonCode",
                  "rationale",
                  "declarationQuote",
                  "moduleQuote"
                ],
                "properties": {
                  "module": {
                    "type": "string",
                    "minLength": 1
                  },
                  "score": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  },
                  "verdict": {
                    "enum": ["accept", "reject", "abstain"]
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "reasonCode": {
                    "enum": [
                      "repository_evidence_supports_match",
                      "wrong_target",
                      "contradicted",
                      "insufficient_evidence",
                      "ambiguous",
                      "multi_module"
                    ]
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1
                  },
                  "declarationQuote": {
                    "type": "string",
                    "minLength": 1
                  },
                  "moduleQuote": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "title",
        "description",
        "priority",
        "target",
        "acceptanceCriteria",
        "requiredRecordLabels",
        "expectedDuplicate"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "requiredRecordLabels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "expectedDuplicate": {
          "type": "boolean"
        }
      }
    },
    "dsl2todoCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "records",
        "proposals"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fixtureRecord"
          }
        },
        "proposals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/proposal"
          }
        }
      }
    },
    "expectedDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "code"
      ],
      "properties": {
        "record": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "diagnosticsCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "records",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "records": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/fixtureRecord"
          }
        },
        "expected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expectedDiagnostic"
          }
        },
        "forbidden": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expectedDiagnostic"
          }
        }
      }
    }
  }
}
