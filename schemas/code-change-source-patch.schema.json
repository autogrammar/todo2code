{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todo2code.local/schemas/code-change-source-patch.schema.json",
  "title": "todo2code Structured Source Change Patch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "patchHash", "status", "createdAt", "planId", "planHash",
    "graphFingerprint", "diagnosticIds", "recordIds", "edits", "acceptanceCriteria", "generation"
  ],
  "properties": {
    "schemaVersion": { "const": "t2c.code-change-source-patch/v1" },
    "id": { "type": "string", "pattern": "^SPATCH-[a-f0-9]{20}$" },
    "patchHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "const": "proposed" },
    "createdAt": { "type": "string", "format": "date-time" },
    "planId": { "type": "string", "pattern": "^CPLAN-[a-f0-9]{20}$" },
    "planHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "graphFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "diagnosticIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^DIAG-[a-f0-9]{20}$" }
    },
    "recordIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^INT-[A-Z]+-[a-f0-9]{20}$" }
    },
    "edits": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/edit" }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "generation": { "$ref": "conclusion.schema.json#/$defs/generation" }
  },
  "$defs": {
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "action", "symbols", "instruction", "unifiedDiff"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "action": { "enum": ["create", "modify", "delete"] },
        "symbols": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "instruction": { "type": "string", "minLength": 1 },
        "unifiedDiff": { "type": ["string", "null"] }
      }
    }
  }
}
