{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todo2code.local/schemas/conclusion.schema.json",
  "title": "todo2code Grounded Conclusion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "kind", "title", "detail", "severity", "diagnosticIds", "recordIds", "confidence", "generation"],
  "properties": {
    "schemaVersion": { "const": "t2c.conclusion/v1" },
    "id": { "type": "string", "pattern": "^CONC-[a-f0-9]{20}$" },
    "kind": { "enum": ["finding", "risk", "decision", "recommendation"] },
    "title": { "type": "string", "minLength": 1 },
    "detail": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["info", "warning", "review_required", "blocking"] },
    "diagnosticIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^DIAG-[a-f0-9]{20}$" }
    },
    "recordIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^INT-[A-Z]+-[a-f0-9]{20}$" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "generation": { "$ref": "#/$defs/generation" }
  },
  "$defs": {
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeVersion", "generatedAt", "requestedMode", "effectiveMode", "degraded", "model", "provider", "responseId", "configurationFingerprint", "reason"],
      "properties": {
        "runtimeVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "requestedMode": { "enum": ["deterministic", "prefer-llm", "require-llm"] },
        "effectiveMode": { "enum": ["deterministic", "llm"] },
        "degraded": { "type": "boolean" },
        "model": { "type": ["string", "null"] },
        "provider": { "type": ["string", "null"] },
        "responseId": { "type": ["string", "null"] },
        "configurationFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reason": { "type": ["string", "null"] }
      }
    }
  }
}
