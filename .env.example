# Core
# Bootstrap-only override used before this file is loaded. Usually leave empty.
T2C_ENV_FILE=
T2C_ROOT=.
T2C_OUTPUT_DIR=.intent
T2C_GIT_COMMIT_COUNT=10
T2C_MAX_FILE_BYTES=524288
T2C_DOC_CONCURRENCY=3
T2C_DOC_CHUNK_CHARS=8000
T2C_DOC_MAX_CHUNKS=12
T2C_DOC_MAX_RECORDS_PER_CHUNK=24
T2C_DOC_TIMEOUT_MS=45000
T2C_PYTHON=python3
T2C_ENABLE_PYTHON_AST=true
T2C_GO=go
T2C_ENABLE_GO_AST=true
T2C_JAVA=java
T2C_ENABLE_JAVA_AST=true
T2C_CARGO=cargo
T2C_ENABLE_RUST_AST=true
T2C_ALLOW_OUTSIDE_ROOT=false

# Optional TensorFlow action classifier. Heuristics remain the deterministic fallback.
T2C_ENABLE_TF=false
T2C_TF_MODEL_PATH=
T2C_TF_MODULE_PATH=adapters/tensorflow/node_modules/@tensorflow/tfjs-node/dist/index.js
T2C_TF_LABELS=add,fix,remove,refactor,test,document,configure,analyze,unknown

# NL/TODO/CHANGELOG -> Intent DSL, documentation -> Intent DSL, Intent DSL -> NL/tasks
T2C_NL_MODE=prefer-llm
T2C_MARKDOWN_MODE=prefer-llm
T2C_COMMUNICATION_MODE=deterministic
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.6-flash
OPENROUTER_NL_MODEL=
OPENROUTER_MARKDOWN_MODEL=
OPENROUTER_COMMUNICATION_MODEL=
OPENROUTER_DOC_MODEL=
OPENROUTER_SUMMARY_MODEL=
OPENROUTER_TASK_MODEL=
OPENROUTER_SITE_URL=http://localhost:8787
OPENROUTER_APP_NAME=todo2code
OPENROUTER_TIMEOUT_MS=120000
OPENROUTER_MAX_TOKENS=6000
OPENROUTER_TEMPERATURE=0
OPENROUTER_REQUIRE_STRUCTURED_OUTPUT=true
OPENROUTER_RESPONSE_HEALING=true

# Opt-in live provider contract check. Offline validation never requires it.
# The check runs all six semantic stages through the pipeline in require-llm.
T2C_REQUIRE_LIVE_CHECK=false
T2C_LIVE_AUDIT_PATH=.intent-live/contract-check.json
# Recorded trend of past runs. Reported, never a pass/fail threshold.
T2C_LIVE_HISTORY_PATH=.intent-live/contract-check-history.json
T2C_LIVE_RUN_OUTPUT=.intent-live-run
# Per-stage ceiling; one slow stage is a signal an average would hide.
T2C_LIVE_MAX_STAGE_LATENCY_MS=300000
# Legacy alias for the per-stage ceiling, still honoured when it is set alone.
T2C_LIVE_MAX_LATENCY_MS=120000
T2C_LIVE_MAX_TOTAL_LATENCY_MS=900000
T2C_LIVE_MAX_COST_USD=0.5

# Default document selection. TODO and CHANGELOG have a dedicated structural + LLM stage.
T2C_DOC_PATTERNS=README.md,docs/**/*.md,project/**/*.md,packages/**/MODULE.md
T2C_DOC_EXCLUDES=node_modules/**,.git/**,dist/**,.intent/**,TODO.md,CHANGELOG.md

# MCP stdio server
T2C_MCP_SERVER_NAME=todo2code
T2C_MCP_SERVER_VERSION=0.5.0

# A2A v1.0 server
T2C_A2A_HOST=0.0.0.0
T2C_A2A_PORT=8787
T2C_A2A_PUBLIC_URL=http://localhost:8787/a2a
T2C_A2A_TOKEN=
T2C_A2A_MAX_BODY_BYTES=1048576
# Optional shared snapshot for restart persistence and multi-replica deployments.
T2C_A2A_TASK_STORE=

# Docker Compose host settings. Container port remains 8787.
T2C_WORKSPACE=.
T2C_DOCKER_HOST_PORT=8787

# SDK/example clients. T2C_A2A_TOKEN above is shared with the server.
T2C_A2A_URL=http://localhost:8787
T2C_EXAMPLE_ROOT=examples/backend
T2C_COMPARE_WORKSPACE=false
T2C_COMPARE_BASE=origin/main
T2C_TYPESCRIPT_CLI=
